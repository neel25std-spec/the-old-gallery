# =============================================================================
# The Old Gallery - Git Line Ending & Attribute Configuration
# =============================================================================
# Set default behavior: auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# -----------------------------------------------------------------------------
# Source Code (TypeScript, JavaScript)
# -----------------------------------------------------------------------------
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.d.ts text eol=lf

# -----------------------------------------------------------------------------
# Styles & Web Markup
# -----------------------------------------------------------------------------
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.svg text eol=lf

# -----------------------------------------------------------------------------
# Configuration, Data & Metadata
# -----------------------------------------------------------------------------
*.json text eol=lf
*.json5 text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.env text eol=lf
*.env.* text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.oxlintrc.json text eol=lf

# -----------------------------------------------------------------------------
# Documentation
# -----------------------------------------------------------------------------
*.md text eol=lf
*.mdx text eol=lf
*.txt text eol=lf
LICENSE text eol=lf

# -----------------------------------------------------------------------------
# Shell & Scripting
# -----------------------------------------------------------------------------
*.sh text eol=lf
*.bash text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# -----------------------------------------------------------------------------
# Binary Assets (Never modify line endings)
# -----------------------------------------------------------------------------
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.mp4 binary
*.webm binary
*.pdf binary
*.zip binary

